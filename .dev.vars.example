APP_ENV=development
APP_ORIGIN=http://127.0.0.1:5173
# 以 openssl rand -base64 32 分别生成；不要公开或复用旧站密钥。
MASTER_KEY=
PHONE_HMAC_KEY=
GITHUB_TOKEN=

# Cloudmersive 查毒：仅服务端使用，切勿提交真实密钥。
CLOUDMERSIVE_API_KEY=
# 标准 TAR 扫描请求上限；免费套餐先按 3.5 MB 限制。
CLOUDMERSIVE_MAX_SCAN_BYTES=3500000

# 人工审核；自动引擎需同时设置 REVIEW_MODE=automatic 和 REVIEW_ENABLED=true。
REVIEW_MODE=manual
REVIEW_ENABLED=false

# 本地默认关闭 SSO；联调独立认证 Worker 时启用并配置站点凭据。
# SSO_CLIENT_SECRET 不是有赞应用密钥或中转密钥。
SSO_ENABLED=false
SSO_ORIGIN=https://auth.zdwifi.com
SSO_CLIENT_SECRET=
